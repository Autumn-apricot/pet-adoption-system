{
  "name": "pet-adoption-system",
  "version": "2.0.0",
  "description": "宠物领养管理系统 — Express + MySQL 后端 API，含 Vue3 管理后台",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js --reset"
  },
  "keywords": [
    "pet",
    "adoption",
    "express",
    "rest-api",
    "mysql",
    "jwt"
  ],
  "author": "董秋杏",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
